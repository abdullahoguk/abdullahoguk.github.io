---
layout: base.njk
scene: true
schemaKind: profile
schemaItems: projects
bodyClass: home
description: "Abdullah Öğük — Düzce'de web yazılım geliştirici. Musiki, makılî ve tipografi, arayüz tasarımı, fotoğraf, kitaplar ve bisiklet. Alaturka Vakitler, Radio TR. Web developer, designer and photographer from Türkiye."
---
{%- macro linkList(items) -%}
<ul class="rows">
  {%- for l in items %}
  <li><a href="{{ l.url }}"{% if l.url.startsWith("http") %} rel="me noopener"{% endif %}>{{ l.label }}</a> <span class="muted">{{ l.handle }}</span></li>
  {%- endfor %}
</ul>
{%- endmacro -%}

{%- macro linkSection(id) -%}
{%- for g in site.links %}{% if g.id == id %}
<section class="block" id="{{ g.id }}">
  <h2 class="label">{{ g.title | bi | safe }}</h2>
  <div>
    <p class="blurb">{{ g.blurb | bi | safe }}</p>
    {{ linkList(g.items) }}
  </div>
</section>
{%- endif %}{% endfor %}
{%- endmacro -%}

<section class="hero">
  <h1 class="sr-only">{{ site.author.name }}, {{ site.author.jobTitle }}</h1>
  <div class="intro">
    {%- for p in site.intro %}
    <p>{{ p | bi | safe }}</p>
    {%- endfor %}
  </div>

  {%- if site.now.length %}
  <div class="now">
    <h2 class="label">şimdi<span class="en" lang="en">now</span></h2>
    <div>
      {%- for p in site.now %}
      <p>{{ p | bi | safe }}</p>
      {%- endfor %}
    </div>
  </div>
  {%- endif %}

  <p class="primary-links">
    {%- for group in site.links %}{% for l in group.items %}{% if l.primary %}
    <a href="{{ l.url }}" rel="me noopener">{{ l.label }}</a><span aria-hidden="true"> / </span>
    {%- endif %}{% endfor %}{% endfor %}
    <a href="/resume/">resume</a>
  </p>
</section>

{{ linkSection("dev") }}

{%- if resume.experience.length %}
<section class="block" id="experience">
  <h2 class="label">deneyim<span class="en" lang="en">experience</span></h2>
  <div>
    <ol class="rows timeline">
      {%- for e in resume.experience %}
      <li>
        <span class="when muted">{{ e | period(true) }}</span>
        <span>{{ e.role }} <span class="muted">@</span> {% if e.url %}<a href="{{ e.url }}" rel="noopener">{{ e.org }}</a>{% else %}{{ e.org }}{% endif %}</span>
      </li>
      {%- endfor %}
    </ol>
    <p class="more"><a href="/resume/">resume →</a> <span class="muted">/</span> <a href="https://www.linkedin.com/in/abdullahoguk" rel="me noopener">linkedin →</a></p>
  </div>
</section>
{%- endif %}

{%- set featured = projects | where("featured", true) %}
{%- if featured.length %}
<section class="block" id="projects">
  <h2 class="label">projeler<span class="en" lang="en">projects</span></h2>
  <div>
    <ul class="rows">
      {%- for p in featured %}
      {%- set detail = collections.projectPages | pageFor(p.id) %}
      <li>
        <a href="{{ detail.url if detail else '/projects/#' + p.id }}">{{ p.title }}</a> <span class="muted">{{ p.year }}{% if p.status == "wip" %} · geliştiriliyor{% endif %}</span>
        <span class="sub">{{ p.summary | bi | safe }}</span>
      </li>
      {%- endfor %}
    </ul>
    <p class="more"><a href="/projects/">tüm projeler →</a></p>
  </div>
</section>
{%- endif %}

{{ linkSection("design") }}
{{ linkSection("photo") }}

<section class="block" id="listens">
  <h2 class="label">dinlediklerim<span class="en" lang="en">listens</span></h2>
  <div>
    <p class="blurb">{{ listens.blurb | bi | safe }}</p>
    <ul class="rows">
      {%- for p in listens.playlists | where("featured", true) %}
      <li><a href="{{ p.url }}" rel="noopener">{{ p.title }}</a> <span class="muted">{{ p.platform }}</span></li>
      {%- endfor %}
      {%- if listens.tekke %}
      <li><a href="{{ listens.tekke.links[0].url }}" rel="noopener">{{ listens.tekke.title }}</a> <span class="muted">{{ listens.tekke.links[0].label }} · <a href="/listens/#tekke-musikisi">hakkında</a></span></li>
      {%- endif %}
    </ul>
    <p class="more"><a href="/listens/">hepsi →</a></p>
  </div>
</section>

{%- if collections.posts.length %}
<section class="block" id="writing">
  <h2 class="label">yazılar<span class="en" lang="en">writing</span></h2>
  <ul class="rows">
    {%- for post in collections.posts | limit(3) %}
    <li><a href="{{ post.url }}">{{ post.data.title }}</a> <time class="muted" datetime="{{ post.date | ymd }}">{{ post.date | ymd }}</time></li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

{{ linkSection("other") }}
