---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if not p.data.noindex and p.url %}
  <url>
    <loc>{{ p.url | absUrl(site.url) }}</loc>
    <lastmod>{{ (p.data.updated or p.date) | ymd }}</lastmod>
  </url>
{%- endif %}{% endfor %}
</urlset>
